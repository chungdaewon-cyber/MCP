# Marketgrid Website Environment Variables
# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://marketgrid.ai
NEXT_PUBLIC_SITE_NAME=Marketgrid

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=contact@marketgrid.ai
NEXT_PUBLIC_CONTACT_PHONE=+82-2-XXXX-XXXX
NEXT_PUBLIC_CONTACT_ADDRESS=서울특별시 강남구 테헤란로 XXX

# Email Service (for contact form)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@marketgrid.ai

# Analytics (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Maps API (optional)
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key
# NEXT_PUBLIC_KAKAO_MAPS_KEY=your-kakao-maps-api-key

# Chat Service (optional)
# NEXT_PUBLIC_INTERCOM_APP_ID=your-intercom-app-id
# NEXT_PUBLIC_CRISP_WEBSITE_ID=your-crisp-website-id

# CRM Integration (optional)
# HUBSPOT_API_KEY=your-hubspot-api-key
# SALESFORCE_API_KEY=your-salesforce-api-key
